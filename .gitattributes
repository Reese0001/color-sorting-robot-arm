# 统一换行符策略，避免 Windows / Linux / macOS 协作时 diff 全变
# 核心思路：仓库里一律存 LF，检出时按平台转换（文本文件）

# 默认：自动检测文本文件，仓库内统一 LF
* text=auto eol=lf

# ---- 板端 Python：必须是 LF ----
# K230 上跑 MicroPython，CRLF 虽然能解析，但混用容易出怪问题
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# ---- STM32 C 源码：Keil 两种都能吃，统一 LF 保持 diff 干净 ----
*.c     text eol=lf
*.h     text eol=lf

# ---- 二进制文件：不要做任何转换 ----
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.pdf   binary
*.zip   binary
*.hex   binary
*.bin   binary
*.axf   binary
*.elf   binary
